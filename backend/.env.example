# Soya Ventures Backend - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# NEVER commit the active .env file to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DB_USER=soya_dev_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soya_ventures

# JWT Authentication
# Generate a strong 256-bit secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=24h

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

