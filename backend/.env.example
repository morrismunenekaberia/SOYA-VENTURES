# Soya Ventures Backend - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# NEVER commit the active .env file to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DB_USER=soya_dev_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soya_ventures

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=24h

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Safaricom Daraja M-Pesa B2C Configuration
# Set MPESA_ENVIRONMENT to 'sandbox' for testbed or 'production' for live
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_sandbox_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_sandbox_consumer_secret_here

# Initiator & Security Credentials
# For Sandbox B2C, initiator is typically 'testapi'
MPESA_INITIATOR_NAME=testapi
# Pre-encrypted security credential or initiator plaintext password for certificate encryption
MPESA_SECURITY_CREDENTIAL=your_encrypted_security_credential_here

# Shortcode & Command:
# NOTE: 174379 is the Daraja sandbox C2B / STK Push shortcode.
# Standard Daraja sandbox B2C shortcode is 600988 (or 600000).
MPESA_B2C_SHORTCODE=600988
MPESA_B2C_COMMAND_ID=BusinessPayment

# Callback Webhooks (Must be publicly accessible HTTPS URLs)
MPESA_RESULT_URL=https://your-public-domain.com/api/payouts/b2c/result
MPESA_TIMEOUT_URL=https://your-public-domain.com/api/payouts/b2c/timeout
MPESA_CALLBACK_SECRET=your_secret_token_to_verify_callbacks
