# Soya Ventures Backend - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# NEVER commit the active .env file to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Structured Logging Configuration
# LOG_LEVEL options: debug, info, warn, error, silent
LOG_LEVEL=debug
# LOG_FORMAT options: pretty (colorized for dev), json (structured for production)
LOG_FORMAT=pretty

# Database Connection (PostgreSQL)
DB_USER=soya_dev_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soya_ventures
DB_POOL_MAX=20

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=24h

# Rate Limiting (Slide window in ms and max attempts)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Safaricom Daraja M-Pesa B2C Configuration
# Set MPESA_ENVIRONMENT to 'sandbox' for testbed or 'production' for live
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_sandbox_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_sandbox_consumer_secret_here

# Initiator & Security Credentials
# For Daraja Sandbox B2C, initiator name is typically 'testapi'
MPESA_INITIATOR_NAME=testapi
# Pre-encrypted security credential (encrypted with Safaricom's public certificate)
MPESA_SECURITY_CREDENTIAL=your_encrypted_security_credential_here

# Shortcode & Command:
# NOTE: 174379 is the Daraja sandbox C2B / STK Push shortcode (for receiving payments).
# For B2C disbursements (sending payouts to recipients), use shortcode 600988 (or 600000).
MPESA_B2C_SHORTCODE=600988
MPESA_B2C_COMMAND_ID=BusinessPayment

# Callback Webhooks (Must be publicly accessible HTTPS URLs, e.g. via ngrok in local development)
MPESA_RESULT_URL=https://your-ngrok-or-domain.com/api/payouts/b2c/result
MPESA_TIMEOUT_URL=https://your-ngrok-or-domain.com/api/payouts/b2c/timeout
MPESA_CALLBACK_SECRET=your_secret_token_to_verify_callbacks
